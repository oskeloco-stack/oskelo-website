# Copy this file to .env.local and fill in your real values from
# Supabase → Project Settings → API. Never commit .env.local itself.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# From resend.com/api-keys — used to email new contact form submissions
# to oskelo.co@gmail.com. Without this set, submissions still save to
# Supabase but no email notification is sent.
RESEND_API_KEY=your-resend-api-key

# --- Admin area (see ADMIN.md for full setup) ---

# Supabase → Project Settings → API → "service_role" secret key.
# Server-only. Never prefix with NEXT_PUBLIC. Used by the admin routes to
# upload images and save content edits.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The one email address allowed to sign in to /admin. Anyone else with a
# Supabase auth account is still rejected. Defaults to oskelo.co@gmail.com.
ADMIN_EMAIL=oskelo.co@gmail.com
